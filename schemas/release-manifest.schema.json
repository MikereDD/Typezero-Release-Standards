{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MikereDD/Typezero-Release-Standards/main/schemas/release-manifest.schema.json",
  "title": "Typezer∅ Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "appId",
    "displayName",
    "platform",
    "architecture",
    "channel",
    "version",
    "publishedAt",
    "minimumVersion",
    "updaterProtocolVersion",
    "minimumUpdaterProtocolVersion",
    "mandatory",
    "releaseNotesUrl",
    "changelogUrl",
    "assets",
    "source",
    "rollback"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "appId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "enum": ["windows", "android"] },
    "architecture": {
      "type": "string",
      "enum": [
        "win-x64",
        "win-arm64",
        "android-universal",
        "android-arm64-v8a",
        "android-armeabi-v7a",
        "android-x86_64"
      ]
    },
    "channel": { "type": "string", "enum": ["stable", "development"] },
    "version": { "$ref": "#/$defs/version" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "minimumVersion": { "$ref": "#/$defs/version" },
    "updaterProtocolVersion": { "type": "integer", "minimum": 1 },
    "minimumUpdaterProtocolVersion": { "type": "integer", "minimum": 1 },
    "mandatory": { "type": "boolean" },
    "mandatoryReason": { "type": "string", "minLength": 1 },
    "releaseNotesUrl": { "$ref": "#/$defs/httpsOrRelativePath" },
    "changelogUrl": { "$ref": "#/$defs/httpsOrRelativePath" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    },
    "source": { "$ref": "#/$defs/source" },
    "rollback": { "$ref": "#/$defs/rollback" }
  },
  "allOf": [
    {
      "if": { "properties": { "mandatory": { "const": true } }, "required": ["mandatory"] },
      "then": { "required": ["mandatoryReason"] }
    },
    {
      "if": { "properties": { "platform": { "const": "android" } }, "required": ["platform"] },
      "then": {
        "properties": {
          "architecture": {
            "enum": ["android-universal", "android-arm64-v8a", "android-armeabi-v7a", "android-x86_64"]
          },
          "assets": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/asset" },
                { "required": ["packageId", "signingCertificateSha256"] }
              ]
            }
          },
          "rollback": {
            "type": "object",
            "additionalProperties": false,
            "required": ["supported", "retainVersions"],
            "properties": {
              "supported": { "const": false },
              "retainVersions": { "const": 0 },
              "minimumRollbackVersion": { "$ref": "#/$defs/version" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "platform": { "const": "windows" } }, "required": ["platform"] },
      "then": {
        "properties": {
          "architecture": { "enum": ["win-x64", "win-arm64"] },
          "rollback": {
            "type": "object",
            "additionalProperties": false,
            "required": ["supported", "retainVersions", "minimumRollbackVersion"],
            "properties": {
              "supported": { "const": true },
              "retainVersions": { "const": 1 },
              "minimumRollbackVersion": { "$ref": "#/$defs/version" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "version": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[0-9]+(?:\\.[0-9]+)+(?:-dev(?:\\.[0-9]+)+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "httpsOrRelativePath": {
      "type": "string",
      "minLength": 1,
      "oneOf": [
        { "pattern": "^https://" },
        { "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" }
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "fileName", "downloadUrl", "size", "sha256", "keyId", "publicKeySha256"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["rsa-sha256", "ecdsa-sha256", "ed25519"] },
        "fileName": { "type": "string", "minLength": 1 },
        "downloadUrl": { "type": "string", "pattern": "^https://" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "keyId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
        "publicKeySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "downloadUrl", "size", "sha256", "signature"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1 },
        "downloadUrl": { "type": "string", "pattern": "^https://" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "signature": { "$ref": "#/$defs/signature" },
        "packageId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$" },
        "signingCertificateSha256": { "$ref": "#/$defs/sha256" },
        "authenticodeSignerThumbprint": { "type": "string", "pattern": "^[A-Fa-f0-9]{40,64}$" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryUrl", "tag", "commit"],
      "properties": {
        "repositoryUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "tag": { "type": "string", "pattern": "^v[0-9]+(?:\\.[0-9]+)+(?:-dev(?:\\.[0-9]+)+)?$" },
        "commit": {
          "type": "string",
          "pattern": "^(?:[A-Fa-f0-9]{40}|[A-Fa-f0-9]{64})$"
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "retainVersions"],
      "properties": {
        "supported": { "type": "boolean" },
        "retainVersions": { "type": "integer", "minimum": 0, "maximum": 5 },
        "minimumRollbackVersion": { "$ref": "#/$defs/version" }
      }
    }
  }
}
